<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             x:Class="LolClientHelper.Views.ChampSelectView"
             x:DataType="viewModels:ChampSelectViewModel">
    <Border Style="{DynamicResource GlassCard}" Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding ChampSelectTabText}" Style="{DynamicResource GlassTitle}" />
            
            <VerticalStackLayout Spacing="12">
                <Border Style="{DynamicResource GlassItem}">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding AutoSendChampSelectMessage}" />
                        <Label VerticalOptions="Center" Text="{Binding AutoSendLabel}" Style="{DynamicResource GlassLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <Border Style="{DynamicResource GlassItem}" Padding="12">
                    <Editor 
                        Text="{Binding ChampSelectMessage, Mode=TwoWay}"
                        Placeholder="{Binding MessagePlaceholder}"
                        AutoSize="TextChanges"
                        HeightRequest="100" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
