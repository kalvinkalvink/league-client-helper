<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             xmlns:services="clr-namespace:LolClientHelper.Services"
             xmlns:converters="clr-namespace:LolClientHelper.Converters"
             x:Class="LolClientHelper.Views.LogsView"
             x:Name="RootView"
             x:DataType="viewModels:LogsViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:SearchHighlightConverter x:Key="SearchHighlightConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Border Style="{DynamicResource GlassCard}" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
            <Label Grid.Row="0"
                   Text="{Binding LogsLabel}"
                   Style="{DynamicResource GlassTitle}" />

            <!-- Toolbar: search + max lines input + action buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <SearchBar Grid.Column="0"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           Placeholder="{Binding SearchLogsPlaceholder}"
                           VerticalOptions="Center" />
                 <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalOptions="Center">
                    <Label Text="Max:"
                           VerticalOptions="Center"
                           FontSize="12"
                           Style="{DynamicResource GlassLabel}" />
                    <Entry x:Name="MaxLogEntriesEntry"
                           Text="{Binding MaxLogEntriesText, Mode=OneWay}"
                           Keyboard="Numeric"
                           WidthRequest="60"
                           VerticalOptions="Center"
                           Completed="OnMaxLogEntriesCompleted"
                           Unfocused="OnMaxLogEntriesUnfocused" />
                </StackLayout>
                <Button Grid.Column="2"
                        Text="{Binding OpenLogsFolderLabel}"
                        Command="{Binding OpenLogsFolderCommand}"
                        Style="{DynamicResource GlassButton}" />
                <Button Grid.Column="3"
                        Text="{Binding ClearLogsLabel}"
                        Command="{Binding ClearLogsCommand}"
                        Style="{DynamicResource GlassButton}" />
            </Grid>

            <!--
                Log display: virtualized CollectionView replaces the old
                Editor+AutoSize+ScrollView approach.
                AutoSize="TextChanges" was causing a full measure/layout pass on
                every log append; CollectionView virtualizes and recycles rows instead.
            -->
            <Border Grid.Row="2" Style="{DynamicResource GlassItem}" Padding="0">
                <CollectionView ItemsSource="{Binding LogEntries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:LogEntry">
                            <Grid Padding="8,3" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                <!-- Timestamp -->
                                <Label Grid.Column="0"
                                       Text="{Binding Timestamp, StringFormat='{0:HH:mm:ss}'}"
                                       FontFamily="Consolas, OpenSansRegular"
                                       FontSize="11"
                                       Opacity="0.6"
                                       VerticalOptions="Center" />
                                <!-- Level badge -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="0"
                                        Padding="4,1"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="ERROR">
                                            <Setter Property="BackgroundColor" Value="#EF4444" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="WARNING">
                                            <Setter Property="BackgroundColor" Value="#F97316" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="INFO">
                                            <Setter Property="BackgroundColor" Value="#3B82F6" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Level}" Value="DEBUG">
                                            <Setter Property="BackgroundColor" Value="#6B7280" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Grid.Column="1" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <MultiBinding Converter="{StaticResource SearchHighlightConverter}">
                                                <Binding Path="Level" />
                                                <Binding Path="BindingContext.SearchText" Source="{x:Reference RootView}" />
                                            </MultiBinding>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>
                                <!-- Source -->
                                <Label Grid.Column="2"
                                       VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <MultiBinding Converter="{StaticResource SearchHighlightConverter}">
                                            <Binding Path="Source" />
                                            <Binding Path="BindingContext.SearchText" Source="{x:Reference RootView}" />
                                        </MultiBinding>
                                    </Label.FormattedText>
                                </Label>
                                <!-- Message -->
                                <Label Grid.Column="3"
                                       FontFamily="Consolas, OpenSansRegular"
                                       FontSize="11"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap">
                                    <Label.FormattedText>
                                        <MultiBinding Converter="{StaticResource SearchHighlightConverter}">
                                            <Binding Path="Message" />
                                            <Binding Path="BindingContext.SearchText" Source="{x:Reference RootView}" />
                                        </MultiBinding>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </Border>
</ContentView>
