<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             x:Class="LolClientHelper.Views.SettingsWindow"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">
    <ScrollView>
        <Border Style="{DynamicResource GlassCard}" Margin="16" Padding="16">
            <VerticalStackLayout Spacing="16">
                <Label Text="{Binding SettingsLabel}" Style="{DynamicResource GlassTitle}" />

                <!-- Poll Interval -->
                <Border Style="{DynamicResource GlassItem}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding PollIntervalLabel}" Style="{DynamicResource GlassLabel}" />
                        <Picker ItemsSource="{Binding PollIntervals}"
                                SelectedItem="{Binding PollIntervalMs}"
                                Style="{DynamicResource GlassPicker}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Language -->
                <Border Style="{DynamicResource GlassItem}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding LanguageLabel}" Style="{DynamicResource GlassLabel}" />
                        <Picker ItemsSource="{Binding LanguageItems}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedLanguageItem}"
                                Style="{DynamicResource GlassPicker}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Theme -->
                <Border Style="{DynamicResource GlassItem}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ThemeLabel}" Style="{DynamicResource GlassLabel}" />
                        <Picker ItemsSource="{Binding ThemeItems}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedThemeItem}"
                                Style="{DynamicResource GlassPicker}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Change Ranking on Start -->
                <Border Style="{DynamicResource GlassItem}">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding ChangeRankingOnStart}" />
                        <Label VerticalOptions="Center"
                               Text="{Binding ChangeRankingOnStartLabel}"
                               Style="{DynamicResource GlassLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Auto Reconnect (was missing from SettingsWindow) -->
                <Border Style="{DynamicResource GlassItem}">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding AutoReconnect}" />
                        <Label VerticalOptions="Center"
                               Text="{Binding AutoReconnectLabel}"
                               Style="{DynamicResource GlassLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Reset -->
                <Button Text="{Binding ResetButtonLabel}"
                        Command="{Binding ResetToDefaultsCommand}"
                        Style="{DynamicResource GlassButton}" />
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
