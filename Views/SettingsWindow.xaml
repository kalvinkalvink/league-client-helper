<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             x:Class="LolClientHelper.Views.SettingsWindow"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding PollIntervalLabel}" />
            <Picker ItemsSource="{Binding PollIntervals}"
                    SelectedItem="{Binding PollIntervalMs}" />

            <Label Text="{Binding LanguageLabel}" />
            <Picker ItemsSource="{Binding LanguageItems}"
                    ItemDisplayBinding="{Binding Display}"
                    SelectedItem="{Binding SelectedLanguageItem}" />

            <Label Text="{Binding ThemeLabel}" />
            <Picker ItemsSource="{Binding ThemeItems}"
                    ItemDisplayBinding="{Binding Display}"
                    SelectedItem="{Binding SelectedThemeItem}" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox IsChecked="{Binding ChangeRankingOnStart}" />
                <Label VerticalOptions="Center"
                       Text="{Binding ChangeRankingOnStartLabel}" />
            </HorizontalStackLayout>

            <Button Text="{Binding ResetButtonLabel}"
                    Command="{Binding ResetToDefaultsCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
