<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             x:Class="LolClientHelper.Views.GameStatusView"
             x:DataType="viewModels:GameStatusViewModel">
    <Border Style="{DynamicResource GlassCard}" Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding GameStatusLabel}" Style="{DynamicResource GlassTitle}" />
            
            <Border Style="{DynamicResource GlassItem}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding GameModeLabel}" Style="{DynamicResource GlassLabel}" />
                    <Picker ItemsSource="{Binding QueueTypeItems}" 
                            ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedQueueTypeItem}" 
                            Style="{DynamicResource GlassPicker}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{DynamicResource GlassItem}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding RankingLabel}" Style="{DynamicResource GlassLabel}" />
                    <Picker ItemsSource="{Binding TierItems}" 
                            ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedTierItem}" 
                            Style="{DynamicResource GlassPicker}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{DynamicResource GlassItem}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding LevelLabel}" Style="{DynamicResource GlassLabel}" />
                    <Picker ItemsSource="{Binding DivisionItems}" 
                            ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedDivisionItem}" 
                            Style="{DynamicResource GlassPicker}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{DynamicResource GlassItem}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding StatusLabel}" Style="{DynamicResource GlassLabel}" />
                    <Picker ItemsSource="{Binding StatusItems}" 
                            ItemDisplayBinding="{Binding Display}"
                            SelectedItem="{Binding SelectedStatusItem}" 
                            Style="{DynamicResource GlassPicker}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding ApplyButtonLabel}" 
                    Style="{DynamicResource GlassButtonPrimary}" 
                    Command="{Binding ApplyFakeRankCommand}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
