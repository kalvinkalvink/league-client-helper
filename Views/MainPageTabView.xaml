<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             x:Class="LolClientHelper.Views.MainPageTabView"
             x:DataType="viewModels:MainPageTabViewModel">
    <Border Style="{DynamicResource GlassCard}" Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="Main Page" Style="{DynamicResource GlassTitle}" />
            
            <Border Style="{DynamicResource GlassItem}">
                <HorizontalStackLayout Spacing="12">
                    <CheckBox IsChecked="{Binding AutoAcceptInvite}" />
                    <Label VerticalOptions="Center" Text="Auto Accept Game Invite" Style="{DynamicResource GlassLabel}" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Border>
</ContentView>