<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             x:Class="LolClientHelper.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel">
    <Border Style="{DynamicResource GlassCard}" Padding="16">
        <ScrollView>
            <VerticalStackLayout Spacing="16">
                <Label Text="Settings" Style="{DynamicResource GlassTitle}" />
                
                <Border Style="{DynamicResource GlassItem}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding PollIntervalLabel}" Style="{DynamicResource GlassLabel}" />
                        <Picker ItemsSource="{Binding PollIntervals}" 
                                SelectedItem="{Binding PollIntervalMs}" 
                                Style="{DynamicResource GlassPicker}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{DynamicResource GlassItem}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding LanguageLabel}" Style="{DynamicResource GlassLabel}" />
                        <Picker ItemsSource="{Binding Languages}" 
                                SelectedItem="{Binding Language}" 
                                Style="{DynamicResource GlassPicker}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{DynamicResource GlassItem}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ThemeLabel}" Style="{DynamicResource GlassLabel}" />
                        <Picker ItemsSource="{Binding Themes}" 
                                SelectedItem="{Binding Theme}" 
                                Style="{DynamicResource GlassPicker}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{DynamicResource GlassItem}">
                    <HorizontalStackLayout Spacing="12">
                        <CheckBox IsChecked="{Binding ChangeRankingOnStart}" />
                        <Label VerticalOptions="Center" 
                               Text="{Binding ChangeRankingOnStartLabel}" 
                               Style="{DynamicResource GlassLabel}" />
                    </HorizontalStackLayout>
                </Border>

                <Button Text="{Binding ResetButtonLabel}" 
                        Style="{DynamicResource GlassButton}" 
                        Command="{Binding ResetToDefaultsCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Border>
</ContentView>