<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:LolClientHelper.ViewModels"
             x:Class="LolClientHelper.MainPage"
             x:DataType="viewModels:MainViewModel"
             Title="LolClientHelper">
    <Grid Padding="12" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Button Text="File" Command="{Binding OpenSettingsCommand}" />
            <Button Grid.Column="1" Text="Settings" Command="{Binding OpenSettingsCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,12" ColumnDefinitions="180,*" ColumnSpacing="12">
            <VerticalStackLayout Spacing="8">
                <Button Text="Game Auto" Command="{Binding SetTabCommand}" CommandParameter="GameAuto" />
                <Button Text="Main Page" Command="{Binding SetTabCommand}" CommandParameter="MainPage" />
                <Button Text="Lobby" Command="{Binding SetTabCommand}" CommandParameter="Lobby" />
                <Button Text="Game Status" Command="{Binding SetTabCommand}" CommandParameter="GameStatus" />
            </VerticalStackLayout>

            <ScrollView Grid.Column="1">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout IsVisible="{Binding IsGameAutoTab}" Spacing="8">
                        <HorizontalStackLayout Spacing="8"><CheckBox IsChecked="{Binding AutoStartGame}" /><Label VerticalOptions="Center" Text="Auto Start Game" /></HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8"><CheckBox IsChecked="{Binding AutoAcceptMatch}" /><Label VerticalOptions="Center" Text="Auto Accept Match" /></HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8"><CheckBox IsChecked="{Binding AutoSkipLike}" /><Label VerticalOptions="Center" Text="Auto Skip Like" /></HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8"><CheckBox IsChecked="{Binding AutoReenterLobby}" /><Label VerticalOptions="Center" Text="Auto Reenter Lobby" /></HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsMainPageTab}" Spacing="8">
                        <HorizontalStackLayout Spacing="8"><CheckBox IsChecked="{Binding AutoAcceptInvite}" /><Label VerticalOptions="Center" Text="Auto Accept Game Invite" /></HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsLobbyTab}" Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Invite All Friends" Command="{Binding InviteAllFriendsCommand}" />
                            <Button Text="Refresh Friends" Command="{Binding RefreshFriendsCommand}" />
                        </HorizontalStackLayout>
                        <Label Text="Filter" />
                        <Picker ItemsSource="{Binding FriendGroups}" SelectedItem="{Binding FriendFilterGroup}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsGameStatusTab}" Spacing="8">
                        <Label Text="Game Mode" />
                        <Picker ItemsSource="{Binding QueueTypes}" SelectedItem="{Binding QueueType}" />
                        <Label Text="Ranking" />
                        <Picker ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}" />
                        <Label Text="Level" />
                        <Picker ItemsSource="{Binding Divisions}" SelectedItem="{Binding Division}" />
                        <Label Text="Status" />
                        <Picker ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" />
                        <Button Text="Apply Rank/Status" Command="{Binding ApplyFakeRankCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Label Grid.Row="2"
               HorizontalOptions="End"
               Text="{Binding ConnectionStatus}" />
    </Grid>
</ContentPage>
