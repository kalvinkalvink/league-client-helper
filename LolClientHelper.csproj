<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows-only: spec section 2 & 13 -->
		<TargetFrameworks>net9.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>LolClientHelper</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>

		<!-- Display name -->
		<ApplicationTitle>LolClientHelper</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.lolclienthelper</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- No MSIX packaging (spec section 13) -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<!-- Windows minimum version (spec section 13) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<BuildTimestamp>$([System.DateTime]::Now.ToString("yyyyMMdd_HHmmss"))</BuildTimestamp>
		<BaseOutputPath>D:\pc_backup\programming_project\csharp\LolClientHelper\bin\dev1</BaseOutputPath>
		<SignAssembly>True</SignAssembly>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- TitleBar Icon -->
		<MauiAsset Include="Resources\AppIcon\LeagueClientHelper.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		<!-- MVVM toolkit (spec section 2 & 12) -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- WMI/CIM process querying for LeagueClientUx.exe (spec §3.1) -->
		<PackageReference Include="System.Management" Version="9.0.4" />
	</ItemGroup>

	<!-- =========================================================================
		 PackagePublishOutput — runs after every Release publish
		  1. Copies publish output to a versioned folder (e.g. LolClientHelper-v1.0)
		  2. Zips it into the same folder (e.g. LolClientHelper-v1.0.zip)
		 ========================================================================= -->
	<Target Name="PackagePublishOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<PackageDirName>$(AssemblyName)-v$(ApplicationDisplayVersion)</PackageDirName>
			<PackageDirPath>$(BaseOutputPath)\$(PackageDirName)</PackageDirPath>
			<PackageZipPath>$(BaseOutputPath)\$(PackageDirName).zip</PackageZipPath>
		</PropertyGroup>

		<Message Text="Packaging publish output to $(PackageDirPath)... _" Importance="high" />

		<Copy SourceFiles="$(PublishDir)**\*"
			  DestinationFiles="$(PackageDirPath)\%(RecursiveDir)%(Filename)%(Extension)" />

		<ZipDirectory SourceDirectory="$(PackageDirPath)"
					  DestinationFile="$(PackageZipPath)"
					  Overwrite="true" />

		<Message Text="Created folder: $(PackageDirPath)" Importance="high" />
		<Message Text="Created zip:    $(PackageZipPath)" Importance="high" />
	</Target>

</Project>
